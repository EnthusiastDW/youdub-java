<configuration>
    <conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter"/>
    <conversionRule conversionWord="wEx" converterClass="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter"/>

    <!-- 生产级控制台日志格式：
         时间 | 级别 | PID | 线程 | 日志器 | 文件:行号 | taskId(MDC) | 消息（异常另起一行缩进） -->
    <property name="CONSOLE_PATTERN"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%-5level) %clr(${PID:- }){magenta} %clr([%thread]){cyan} %clr(%logger{36}){yellow} %clr(%file:%line){blue} %clr([%X{taskId:-}]){green} - %msg%n%wEx"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="TASK_LOG" class="com.youdub.replica.logging.TaskLogAppender"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="TASK_LOG"/>
    </root>
</configuration>
